<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Rubeus</RootNamespace>
    <AssemblyName>Rubeus</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Ignore platform compatibility warnings for cross-platform compilation -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.DirectoryServices" Version="10.0.0-preview.1.25080.5" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.0-preview.1.25080.5" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.0-preview.1.25080.5" />
    <PackageReference Include="System.Management" Version="10.0.0-preview.1.25080.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.0-preview.1.25080.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- This ensures our manual implementation handles OS specifics -->
  </ItemGroup>

</Project>
